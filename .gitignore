# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Secrets and local config – never commit
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
